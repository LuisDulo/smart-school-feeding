# Copy to backend/.env and fill in real values. Never commit backend/.env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call the API when DEBUG=False
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to 1 when running behind a single proxy (e.g. ngrok) so rate limits
# key on the real client IP
# NUM_PROXIES=1

# PostgreSQL
DB_NAME=feeding_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Safaricom Daraja (M-Pesa) sandbox credentials from developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your-sandbox-passkey
# Public HTTPS URL that reaches POST /api/payments/callback/ (e.g. an ngrok tunnel)
DARAJA_CALLBACK_URL=https://your-tunnel.ngrok-free.app/api/payments/callback/
DARAJA_TEST_PHONE=254708374149
